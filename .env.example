# ===============================
# Site Configuration
# ===============================

# Primary hostname for canonical URLs and analytics (no protocol)
DOMAIN=yoursite.com

# Public R2 / CDN domain used to serve gallery images and album artwork
# Example: cdn.yoursite.com
R2_PUBLIC_DOMAIN=

# Optional Plausible Analytics configuration. Leave blank to disable analytics.
ANALYTICS_URL=

# Optional Plausible Stats API key. Required only for public pageview counts.
PLAUSIBLE_KEY=

# ===============================
# Cloudflare R2 Configuration
# ===============================

# Cloudflare account ID
ACCOUNT_ID=

# R2 bucket name
BUCKET=

# R2 access credentials (S3-compatible)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
