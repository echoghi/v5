---
import Head from '@/components/Head.astro'
import { analyticsConfig } from '@/lib/analytics-config'
import { SITE } from '@/site.config'

type Props = {
  title: string
  description: string
  image?: string
}

const { title, description, image } = Astro.props
---

<!doctype html>
<html lang="en" class="photostream-document">
  <head>
    <Head
      title={`${title} | ${SITE.TITLE}`}
      description={description}
      image={image}
    />

    {
      analyticsConfig && (
        <script
          defer
          is:inline
          data-domain={analyticsConfig.domain}
          src={`${analyticsConfig.apiHost}/js/script.outbound-links.tagged-events.js`}
        />
      )
    }
  </head>
  <body class="photostream-page">
    <main>
      <slot />
    </main>
  </body>
</html>
