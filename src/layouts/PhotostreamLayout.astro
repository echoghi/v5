---
import Head from '@/components/Head.astro'
import { analyticsConfig } from '@/lib/analytics-config'
import { SITE } from '@/site.config'

type Props = {
  title: string
  description: string
  image?: string
}

const { title, description, image } = Astro.props
---

<!doctype html>
<html lang="en" class="photostream-document">
  <head>
    <script is:inline>
      if (!window.__photostreamPopstateInterceptorInstalled) {
        window.__photostreamPopstateInterceptorInstalled = true
        window.addEventListener('popstate', (event) => {
          if (
            !document.querySelector('[data-photostream]') ||
            !event.state?.__photostream
          ) {
            return
          }

          event.stopImmediatePropagation()
          window.dispatchEvent(new CustomEvent('photostream:popstate'))
        })
      }
    </script>

    <Head
      title={`${title} | ${SITE.TITLE}`}
      description={description}
      image={image}
    />

    {
      analyticsConfig && (
        <script
          defer
          is:inline
          data-domain={analyticsConfig.domain}
          src={`${analyticsConfig.apiHost}/js/script.outbound-links.tagged-events.js`}
        />
      )
    }
  </head>
  <body class="photostream-page">
    <main>
      <slot />
    </main>
  </body>
</html>
