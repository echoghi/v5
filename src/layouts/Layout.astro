---
import DevThemeToggle from '@/components/DevThemeToggle.astro'
import Footer from '@/components/Footer.astro'
import Head, { type ArticleMeta } from '@/components/Head.astro'
import Header from '@/components/Header.astro'
import { analyticsConfig } from '@/lib/analytics-config'
import { SITE } from '@/site.config'

type Props = {
  title: string
  description: string
  image?: string
  article?: ArticleMeta
}

const { title, description, image, article } = Astro.props
const showDevThemeToggle = import.meta.env.DEV
---

<!doctype html>
<html lang="en">
  <head>
    <Head
      title={`${title} | ${SITE.TITLE}`}
      description={description}
      image={image}
      article={article}
    />

    {
      analyticsConfig && (
        <script
          defer
          is:inline
          data-domain={analyticsConfig.domain}
          src={`${analyticsConfig.apiHost}/js/script.outbound-links.tagged-events.js`}
        />
      )
    }
  </head>
  <body class="overflow-x-hidden">
    <div
      class="isolate box-border flex min-h-dvh flex-col font-sans antialiased"
    >
      <Header />
      <main class="grow pb-12 pt-5 sm:pb-16 sm:pt-8">
        <slot />
      </main>
      <Footer />
    </div>
    {showDevThemeToggle && <DevThemeToggle />}
  </body>
</html>
