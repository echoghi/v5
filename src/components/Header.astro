---
import Container from '@/components/Container.astro'
import Link from '@/components/Link.astro'
import MobileMenu from '@/components/ui/mobile-menu'
import { NAV_LINKS } from '@/site.config'
import Logo from './Logo.astro'

const pathname = Astro.url.pathname
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href)
---

<header
  class="sticky top-3 z-30"
  id="main-header"
  data-scrolled="false"
>
  <Container>
    <div
      class="liquid-glass liquid-glass-adaptive site-header-surface mx-auto flex items-center justify-between gap-3 rounded-2xl px-2.5 py-2 sm:px-3"
    >
      <Link
        href="/"
        aria-label="Homepage"
        class="z-50 flex shrink-0 items-center rounded-xl p-1 text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
      >
        <Logo />
      </Link>
      <div class="flex items-center gap-2">
        <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
          {
            NAV_LINKS.map((item) => (
              <Link
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'rounded-xl px-3 py-2 text-sm capitalize text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring',
                  isActive(item.href) && 'bg-secondary/60 text-foreground',
                ]}
              >
                {item.label}
              </Link>
            ))
          }
        </nav>
        <MobileMenu client:load currentPath={pathname} />
      </div>
    </div>
  </Container>
</header>

<script>
  type HeaderWindow = Window & {
    __siteHeaderController?: AbortController
  }

  const runtimeWindow = window as HeaderWindow

  function setupHeader() {
    runtimeWindow.__siteHeaderController?.abort()
    const controller = new AbortController()
    runtimeWindow.__siteHeaderController = controller
    const header = document.getElementById('main-header')
    if (!header) return

    const updateHeader = () => {
      header.dataset.scrolled = String(window.scrollY > 16)
    }

    updateHeader()
    window.addEventListener('scroll', updateHeader, {
      passive: true,
      signal: controller.signal,
    })
  }

  document.addEventListener('astro:page-load', setupHeader)
  setupHeader()
</script>
