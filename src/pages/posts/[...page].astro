---
import Container from '@/components/Container.astro'
import HomePostCard from '@/components/HomePostCard.astro'
import PaginationComponent from '@/components/ui/pagination'
import Layout from '@/layouts/Layout.astro'
import { SITE } from '@/site.config'
import type { PaginateFunction } from 'astro'
import { getCollection } from 'astro:content'

export async function getStaticPaths({
  paginate,
}: {
  paginate: PaginateFunction
}) {
  const allPosts = await getCollection('blog', ({ data }) => !data.draft)
  return paginate(
    allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
    { pageSize: SITE.POSTS_PER_PAGE },
  )
}

const { page } = Astro.props
---

<Layout
  title="Posts"
  description="My simple hypertext garden where I tend to thoughts about software, life, and other things that drift through my stream of consciousness."
>
  <Container class="flex grow flex-col gap-8 pt-8 sm:gap-10 sm:pt-12">
    <section
      class="overflow-hidden rounded-2xl border border-foreground/10 bg-background/30"
    >
      <div class="px-4 pb-2 pt-4 sm:px-5 sm:pt-5">
        <h1 class="font-sans text-2xl font-semibold">Posts</h1>
      </div>
      <ul class="not-prose flex flex-col px-1 pb-1" role="list">
        {
          page.data.map((post) => (
            <li>
              <HomePostCard entry={post} />
            </li>
          ))
        }
      </ul>
    </section>

    <PaginationComponent
      currentPage={page.currentPage}
      totalPages={page.lastPage}
      baseUrl="/posts/"
      client:load
    />
  </Container>
</Layout>
