---
import Container from '@/components/Container.astro'
import HomePhotos from '@/components/HomePhotos.astro'
import HomePostCard from '@/components/HomePostCard.astro'
import Icon from '@/components/Icon.astro'
import Link from '@/components/Link.astro'
import PhotoGlobe from '@/components/PhotoGlobe.astro'
import Layout from '@/layouts/Layout.astro'
import { getPhotostreamImages, getRecentPhotos } from '@/lib/server-utils'
import { formatDate } from '@/lib/utils'
import { SITE } from '@/site.config'
import { getCollection, getEntry } from 'astro:content'

const allPosts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
const latestPosts = allPosts.slice(0, SITE.NUM_POSTS_ON_HOMEPAGE)

const photos = await getPhotostreamImages(await getCollection('photos'))
const recentPhotos = getRecentPhotos(photos, SITE.NUM_PHOTOS_ON_HOMEPAGE)
const placeCount = new Set(photos.map((photo) => photo.location)).size

const now = await getEntry('now', 'index')
---

<Layout title="Home" description={SITE.DESCRIPTION} image="/og/home.png">
  <Container class="flex flex-col gap-12 sm:gap-16">
    <section class="flex flex-col gap-5 pb-2 pt-8 sm:pt-12">
      <h1
        class="max-w-[20ch] text-balance font-sans text-5xl font-semibold tracking-tight sm:text-6xl"
      >
        Hey, I’m Emile.
      </h1>
      <div class="flex flex-col gap-4 font-editorial">
        <p class="text-pretty text-lg text-primary">
          I’m a software engineer who enjoys designing and building useful
          things for the web. Currently, I’m focused on building small
          businesses at{' '}
          <Link
            href="https://rennalabs.xyz/"
            class="text-foreground"
            external
            underline>Renna Labs</Link
          >.
        </p>
        <p class="text-pretty text-lg text-muted-foreground">
          This is my small corner of the web. It’s a hypertext garden where I
          share thoughts on software, life, and whatever else drifts through my
          stream of consciousness.
        </p>
      </div>
      {
        now && (
          <Link
            href="/now"
            class="group hover:bg-secondary/25 focus-visible:ring-ring -mx-3 flex items-start gap-3 self-start rounded-xl px-3 py-2 font-sans text-base focus-visible:ring-2 focus-visible:outline-hidden"
          >
            <span class="now-dot mt-[0.55rem] size-2 shrink-0 rounded-full bg-[var(--flexoki-green-400)]" />
            <span class="flex flex-col">
              <span class="text-pretty">
                <span class="font-semibold">Now:</span> {now.data.summary}
              </span>
              <span class="text-muted-foreground text-sm tabular-nums">
                Updated {formatDate(now.data.updated)}
              </span>
            </span>
            <Icon
              name="lucide:chevron-right"
              class="text-muted-foreground mt-1 size-4 shrink-0 transition-transform group-hover:translate-x-0.5"
            />
          </Link>
        )
      }
    </section>
    <HomePhotos
      photos={recentPhotos}
      totalCount={photos.length}
      placeCount={placeCount}
    />
    <PhotoGlobe photos={photos} />
    <section
      class="overflow-hidden rounded-2xl border border-foreground/10 bg-background/30"
    >
      <div
        class="flex items-center justify-between gap-4 px-4 pb-2 pt-4 sm:px-5 sm:pt-5"
      >
        <h2 class="font-sans text-2xl font-semibold">Posts</h2>
        <Link
          href="/posts"
          class="group flex shrink-0 items-center gap-1.5 font-sans text-base font-medium text-muted-foreground focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring sm:text-sm"
        >
          <span>{latestPosts.length} of {allPosts.length} posts</span>
          <Icon
            name="lucide:chevron-right"
            class="size-4 transition-transform group-hover:translate-x-0.5"
          />
        </Link>
      </div>
      <ul class="not-prose flex flex-col px-1 pb-1" role="list">
        {
          latestPosts.map((post) => (
            <li>
              <HomePostCard entry={post} />
            </li>
          ))
        }
      </ul>
    </section>
  </Container>
</Layout>
